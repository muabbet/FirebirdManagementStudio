unit uTabloTasarim;

{ Yeni tabloyu gridde tasarlayip olusturma (Asama 7g): kolon adi, veri tipi, boyut, bos olamaz, birincil anahtar, otomatik artan,
  varsayilan. Bu birim CREATE TABLE metnini kurar, kontrol eder ve calistirir; pencere (fTabloTasarim) sadece gridi bilir.

  Hedeflenen Firebird surumleri: 2.5, 3.0, 4.0, 5.0
  Surum farki: otomatik artan kolon (GENERATED BY DEFAULT AS IDENTITY) Firebird 3.0'dan once yoktur (KimlikDestegi).

  Kurallar (sade ve guvenli):
    - Tablo tek komutla ve tek islemde olusturulur (CREATE TABLE); hata olursa hicbir sey olusmaz.
    - Birincil anahtar kolonlari otomatik BOS OLAMAZ olur (Firebird ister). Otomatik artan kolon yalniz tam sayi tipinde, tabloda en cok bir
      tane olabilir ve bos olamaz sayilir.
    - Yabanci anahtar ve index tasarimda yok; tablo olustuktan sonra tablo sekmesinden eklenir.
  Hata istisna olarak firlamaz (olusturma); denetim anlasilir cumle dondurur. }

interface

uses
  System.SysUtils, System.Classes, uBaglanti, uMetadata, uProsedur;

type
  TTasarimKolon = record
    Ad: string;
    { Veri tipi listesindeki ad (VARCHAR, INTEGER, domain adi vb.). }
    Tip: string;
    { Tip isterse: CHAR/VARCHAR icin "50", NUMERIC/DECIMAL icin "18,2"; istemiyorsa yok sayilir. }
    Boyut: string;
    BosOlmaz: Boolean;
    Birincil: Boolean;
    OtoArtan: Boolean;
    { DEFAULT sozcugu OLMADAN ifade ('0', '''ABC''', CURRENT_DATE); bos = yok. }
    Varsayilan: string;
  end;

{ Otomatik artan kolon bu Firebird surumunde var mi (3.0 ve ustu)? }
function KimlikDestegi(Bag: TAcikBaglanti): Boolean;

{ Tip adina gore listedeki satir; yoksa False. }
function TasarimTipiBul(const Ad: string; const Tipler: TArray<TVeriTipi>; out Tip: TVeriTipi): Boolean;

{ Tip degisince boyut kutusuna yazilacak onceden dolu deger ("50", "18,2"); boyut istemeyen tipte bos. }
function TasarimBoyutVarsayilani(const Tip: TVeriTipi): string;

{ Otomatik artan olabilen tam sayi tipi mi? }
function TasarimTamSayiMi(const Tip: string): Boolean;

{ Eksik / gecersiz tasarimda anlasilir cumle, tamamsa bos. Veritabanina bakmaz (yalniz en cok hassasiyet icin surume). }
function TasarimDogrula(Bag: TAcikBaglanti; const Tablo: string; const Kolonlar: TArray<TTasarimKolon>;
  const Tipler: TArray<TVeriTipi>): string;

{ Calisacak CREATE TABLE metni (noktali virgulle biter). Tasarim gecersizse bos. Tablo ve kolon adlari basit ise buyuk harfe cevrilir,
  degilse "..." icine alinir. }
function TasarimScripti(Bag: TAcikBaglanti; const Tablo: string; const Kolonlar: TArray<TTasarimKolon>;
  const Tipler: TArray<TVeriTipi>): string;

{ Veritabaninda bu adda tablo var mi? (Tablo, TasarimTabloAdi ile hazirlanmis ad.) }
function TasarimTabloVarMi(Bag: TAcikBaglanti; const HazirAd: string): Boolean;

{ Yazilan tablo adinin veritabaninda kullanilacak hali (basitse buyuk harf). }
function TasarimTabloAdi(const Girilen: string): string;

{ Tabloyu olusturur (tek islem, hatada hicbir sey olusmaz). }
function TasarimOlustur(Bag: TAcikBaglanti; const Tablo: string; const Kolonlar: TArray<TTasarimKolon>;
  const Tipler: TArray<TVeriTipi>): TProsedurSonucu;

implementation

uses
  System.Variants, uDil, uDDL, uKolon, uNesneYonet;

function KimlikDestegi(Bag: TAcikBaglanti): Boolean;
begin
  Result := StrToIntDef(Copy(Bag.Surum, 1, 1), 0) >= 3;
end;

function TasarimTipiBul(const Ad: string; const Tipler: TArray<TVeriTipi>; out Tip: TVeriTipi): Boolean;
var
  Aday: TVeriTipi;
begin
  Result := False;
  for Aday in Tipler do
    if SameText(Aday.Ad, Trim(Ad)) then
    begin
      Tip := Aday;
      Exit(True);
    end;
end;

function TasarimBoyutVarsayilani(const Tip: TVeriTipi): string;
begin
  case Tip.Parametre of
    tpUzunluk: Result := IntToStr(Tip.Varsayilan1);
    tpHassasiyet: Result := IntToStr(Tip.Varsayilan1) + ',' + IntToStr(Tip.Varsayilan2);
  else
    Result := '';
  end;
end;

function TasarimTamSayiMi(const Tip: string): Boolean;
begin
  Result := SameText(Trim(Tip), 'SMALLINT') or SameText(Trim(Tip), 'INTEGER') or SameText(Trim(Tip), 'BIGINT');
end;

{ "50" ya da "18,2" -> sayilar (eksik olan 0). }
procedure BoyutSayilari(const Boyut: string; out Sayi1, Sayi2: Integer);
var
  Parca: TArray<string>;
begin
  Parca := Boyut.Split([',', ';', '.']);
  Sayi1 := 0;
  Sayi2 := 0;
  if Length(Parca) > 0 then
    Sayi1 := StrToIntDef(Trim(Parca[0]), 0);
  if Length(Parca) > 1 then
    Sayi2 := StrToIntDef(Trim(Parca[1]), 0);
end;

{ Kolonun tip metni: boyutlu ya da domain adi. Tip bilinmiyorsa bos. }
function KolonTipMetni(Bag: TAcikBaglanti; const Kolon: TTasarimKolon; const Tipler: TArray<TVeriTipi>): string;
var
  Tip: TVeriTipi;
  Sayi1, Sayi2: Integer;
begin
  Result := '';
  if not TasarimTipiBul(Kolon.Tip, Tipler, Tip) then
    Exit;
  if Tip.Domain then
    Exit(AdiYaz(Bag, Tip.Ad));
  BoyutSayilari(Kolon.Boyut, Sayi1, Sayi2);
  Result := TipMetniOlustur(Tip, Sayi1, Sayi2);
end;

function TasarimTabloAdi(const Girilen: string): string;
begin
  Result := AdHazirla(Girilen);
end;

function TasarimDogrula(Bag: TAcikBaglanti; const Tablo: string; const Kolonlar: TArray<TTasarimKolon>;
  const Tipler: TArray<TVeriTipi>): string;
var
  i, j, Sayi1, Sayi2, OtoSayisi: Integer;
  Tip: TVeriTipi;
  Uyari: string;
begin
  Result := '';
  if Trim(Tablo) = '' then
    Exit(T('ERR_TAS_TABLO_AD_BOS'));
  if Length(Kolonlar) = 0 then
    Exit(T('ERR_TAS_KOLON_YOK'));
  OtoSayisi := 0;
  for i := 0 to High(Kolonlar) do
  begin
    if Trim(Kolonlar[i].Ad) = '' then
      Exit(TF('ERR_TAS_KOLON_AD_BOS', [i + 1]));
    for j := 0 to i - 1 do
      if SameText(TasarimTabloAdi(Kolonlar[j].Ad), TasarimTabloAdi(Kolonlar[i].Ad)) then
        Exit(TF('ERR_TAS_KOLON_AD_TEKRAR', [Trim(Kolonlar[i].Ad)]));
    if not TasarimTipiBul(Kolonlar[i].Tip, Tipler, Tip) then
      Exit(TF('ERR_TAS_TIP_YOK', [Trim(Kolonlar[i].Ad)]));
    if not Tip.Domain then
    begin
      BoyutSayilari(Kolonlar[i].Boyut, Sayi1, Sayi2);
      Uyari := TipSayilariniDogrula(Bag, Tip, Sayi1, Sayi2);
      if Uyari <> '' then
        Exit(TF('ERR_TAS_BOYUT', [Trim(Kolonlar[i].Ad), Uyari]));
    end;
    if Kolonlar[i].OtoArtan then
    begin
      Inc(OtoSayisi);
      if not TasarimTamSayiMi(Kolonlar[i].Tip) then
        Exit(TF('ERR_TAS_OTO_TIP', [Trim(Kolonlar[i].Ad)]));
      if Trim(Kolonlar[i].Varsayilan) <> '' then
        Exit(TF('ERR_TAS_OTO_VARSAYILAN', [Trim(Kolonlar[i].Ad)]));
    end;
  end;
  if OtoSayisi > 1 then
    Exit(T('ERR_TAS_OTO_COK'));
  if (OtoSayisi > 0) and not KimlikDestegi(Bag) then
    Exit(T('ERR_TAS_OTO_SURUM'));
end;

{ Bir kolonun CREATE TABLE satiri. }
function KolonSatiri(Bag: TAcikBaglanti; const Kolon: TTasarimKolon; const Tipler: TArray<TVeriTipi>): string;
begin
  Result := AdiYaz(Bag, TasarimTabloAdi(Kolon.Ad)) + ' ' + KolonTipMetni(Bag, Kolon, Tipler);
  if Kolon.OtoArtan then
    Result := Result + ' GENERATED BY DEFAULT AS IDENTITY'
  else
  begin
    if Trim(Kolon.Varsayilan) <> '' then
      Result := Result + ' DEFAULT ' + Trim(Kolon.Varsayilan);
    if Kolon.BosOlmaz or Kolon.Birincil then
      Result := Result + ' NOT NULL';
  end;
end;

function TasarimScripti(Bag: TAcikBaglanti; const Tablo: string; const Kolonlar: TArray<TTasarimKolon>;
  const Tipler: TArray<TVeriTipi>): string;
var
  i: Integer;
  Anahtar, Satirlar: string;
begin
  Result := '';
  if TasarimDogrula(Bag, Tablo, Kolonlar, Tipler) <> '' then
    Exit;
  Satirlar := '';
  Anahtar := '';
  for i := 0 to High(Kolonlar) do
  begin
    if i > 0 then
      Satirlar := Satirlar + ',' + sLineBreak;
    Satirlar := Satirlar + '    ' + KolonSatiri(Bag, Kolonlar[i], Tipler);
    if Kolonlar[i].Birincil then
    begin
      if Anahtar <> '' then
        Anahtar := Anahtar + ', ';
      Anahtar := Anahtar + AdiYaz(Bag, TasarimTabloAdi(Kolonlar[i].Ad));
    end;
  end;
  if Anahtar <> '' then
    Satirlar := Satirlar + ',' + sLineBreak + '    PRIMARY KEY (' + Anahtar + ')';
  Result := 'CREATE TABLE ' + AdiYaz(Bag, TasarimTabloAdi(Tablo)) + ' (' + sLineBreak + Satirlar + sLineBreak + ');';
end;

function TasarimTabloVarMi(Bag: TAcikBaglanti; const HazirAd: string): Boolean;
begin
  Result := VarToStr(Bag.Baglanti.ExecSQLScalar('select count(*) from rdb$relations where rdb$relation_name = :A', [HazirAd])) <> '0';
end;

function TasarimOlustur(Bag: TAcikBaglanti; const Tablo: string; const Kolonlar: TArray<TTasarimKolon>;
  const Tipler: TArray<TVeriTipi>): TProsedurSonucu;
var
  Uyari: string;
begin
  Result := Default(TProsedurSonucu);
  Uyari := TasarimDogrula(Bag, Tablo, Kolonlar, Tipler);
  if Uyari <> '' then
  begin
    Result.Cumle := Uyari;
    Exit;
  end;
  if TasarimTabloVarMi(Bag, TasarimTabloAdi(Tablo)) then
  begin
    Result.Cumle := TF('ERR_TAS_TABLO_VAR', [TasarimTabloAdi(Tablo)]);
    Exit;
  end;
  MetniCalistir(Bag, TasarimScripti(Bag, Tablo, Kolonlar, Tipler), Result);
end;

end.
